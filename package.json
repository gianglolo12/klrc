{
  "name": "klrc",
  "version": "0.1.0",
  "description": "Karaoke lyrics in your terminal",
  "type": "module",
  "bin": {
    "klrc": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "dist",
    "commands",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=25000 \"src/**/*.test.ts\"",
    "dev": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "karaoke",
    "lyrics",
    "cli",
    "terminal",
    "lrc"
  ],
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gianglolo12/klrc.git"
  },
  "homepage": "https://github.com/gianglolo12/klrc#readme",
  "bugs": {
    "url": "https://github.com/gianglolo12/klrc/issues"
  },
  "author": "gianglolo12"
}
